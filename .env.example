# Copy to .env and fill in. Never commit real secrets.

# --- Azure OpenAI (AI Analyst agent) ---
# Option A: API key
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-07-18

# Option B: az login credential chain instead of an API key
AZURE_USE_CLI_CREDENTIAL=false

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Business constants ---
CURRENCY=INR
REPLACEMENT_COST_MULTIPLIER=0.75
TRAINING_COST_PER_EMPLOYEE=50000
COACHING_COST_PER_EMPLOYEE=15000
